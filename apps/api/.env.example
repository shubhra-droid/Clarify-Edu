# ClarifyEdu API Environment Variables
# Copy to .env and fill in values

DEBUG=true
ENVIRONMENT=development

# CORS — comma-separated origins (override via JSON list in production)
# CORS_ORIGINS=["http://localhost:3000"]

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=clarify_edu

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# AI Providers
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# File Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
